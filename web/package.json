{
  "name": "steward-web",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/precompress.mjs && node scripts/bundle-size.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && playwright test",
    "e2e:perf": "npm run build && STEWARD_E2E_PERF=1 playwright test --project=perf",
    "e2e:ui": "playwright test --ui",
    "size": "node scripts/bundle-size.mjs",
    "icons": "node scripts/make-icons.mjs",
    "shots": "node e2e/mockup-shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.108.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
